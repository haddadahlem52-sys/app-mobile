<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:text="ITQuiz"
            android:textColor="#805477"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Créer votre compte"
            android:textColor="#332431"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Commencez votre parcours informatique."
            android:textColor="#888088"
            android:textSize="14sp" />

        <!-- Nom complet -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Nom complet"
            android:textColor="#332431"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B58AA8"
            android:hint="Votre nom complet"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Adresse e-mail"
            android:textColor="#332431"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B58AA8"
            android:hint="exemple@email.com"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- Mot de passe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Mot de passe"
            android:textColor="#332431"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B58AA8"
            android:hint="Saisissez votre mot de passe"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- Confirmation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Confirmer le mot de passe"
            android:textColor="#332431"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B58AA8"
            android:hint="Confirmez votre mot de passe"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#F1E1ED"
            android:padding="15dp"
            android:text="Bienvenue sur ITQuiz ! Découvrez les quiz de programmation, bases de données, réseaux et cybersécurité."
            android:textColor="#65445F"
            android:textSize="13sp" />

        <!-- Bouton inscription -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#805477"
            android:text="Créer mon compte →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Lien connexion -->
        <TextView
            android:id="@+id/txtGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Vous avez déjà un compte ? Se connecter"
            android:textColor="#805477"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>