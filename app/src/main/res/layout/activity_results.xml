
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz terminé !"
            android:textColor="#302633"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResultCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Programmation"
            android:textColor="#817582"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txtResultScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="4 / 5"
            android:textColor="#B784A7"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResultPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="80 %"
            android:textColor="#302633"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResultMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Excellent travail ! Continue comme ça."
            android:textColor="#817582"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRetryQuiz"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#B784A7"
            android:text="Rejouer"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E8D6E4"
            android:text="Retour à l'accueil"
            android:textColor="#302633"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
