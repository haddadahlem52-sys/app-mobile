
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtQuizCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Programmation"
            android:textColor="#B784A7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtQuestionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Question 1 / 5"
            android:textColor="#817582"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/quizProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="5"
            android:progress="1"
            android:progressTint="#B784A7"
            android:progressBackgroundTint="#E8D6E4" />

        <TextView
            android:id="@+id/txtQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Que signifie HTML ?"
            android:textColor="#302633"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/answerA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:text="A. HyperText Markup Language"
            android:textColor="#302633"
            android:textSize="16sp"
            android:elevation="3dp" />

        <TextView
            android:id="@+id/answerB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:text="B. HighText Machine Language"
            android:textColor="#302633"
            android:textSize="16sp"
            android:elevation="3dp" />

        <TextView
            android:id="@+id/answerC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:text="C. Hyper Transfer Main Language"
            android:textColor="#302633"
            android:textSize="16sp"
            android:elevation="3dp" />

        <TextView
            android:id="@+id/answerD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:text="D. Home Tool Markup Language"
            android:textColor="#302633"
            android:textSize="16sp"
            android:elevation="3dp" />

        <Button
            android:id="@+id/btnNextQuestion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#B784A7"
            android:text="Question suivante"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
